# Backend environment — copy this file to .env, then adjust if needed.
# Windows:  Copy-Item .env.example .env
# The real .env is gitignored — never commit your secrets.

# Port the Express API listens on
PORT=5000

# Local MongoDB connection string (database name: olx)
MONGO_URL=mongodb://127.0.0.1:27017/olx

# Secret used to sign/verify JWTs — any long random string works for local dev.
# In production, generate a real one and keep it secret.
JWT_SECRET=change-me-to-a-long-random-string
