# Backend environment — copy this file to .env, then adjust if needed.
# Windows:  Copy-Item .env.example .env
# The real .env is gitignored — never commit your secrets.

# Port the Express API listens on
PORT=5000

# Local MongoDB connection string (database name: olx)
MONGO_URL=mongodb://127.0.0.1:27017/olx

# Secret used to sign/verify ACCESS tokens — any long random string works for local dev.
# In production, generate a real one and keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime. Short on purpose: it is the token that expires and gets refreshed.
# Demo tip: set 30s, log in, wait 40s, click anything — the app refreshes silently, no logout.
ACCESS_TOKEN_TTL=15m

# Refresh token secret (falls back to JWT_SECRET when unset). Kept separate so an access-token
# leak cannot mint refresh tokens.
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_TTL=7d
