<link rel="stylesheet" href="/styles/adminLogin.css">

<div class="login-container">
    <div class="login-box">
        <header class="login-header">
            <h1>Admin Login</h1>
            <p>Authorization required for access</p>
        </header>

        {{#if error}}
            <div class="alert-error">
                {{error}}
            </div>
        {{/if}}

        <form id="login-form" action="/admin/login" method="POST" >
            <div class="form-group">
                <input type="text" id="message" value="{{{message}}}"name="message" hidden>
                <label>System Email</label>
                <input type="email" id="email" name="email" placeholder="admin@company.local"  value="{{{email}}}">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" id="password" name="password" placeholder="••••••••">
            </div>

            <button type="submit" class="btn-login">Login</button>
        </form>
    </div>
</div>

<script>
 document.addEventListener("DOMContentLoaded", () => {
    const messageInput = document.getElementById("message");

    if (messageInput && messageInput.value) {
        Swal.fire({
            text: messageInput.value
        });

        // prevent alert on refresh
        messageInput.value = "";
    }
});
</script>

<script>

    document.getElementById("login-form").addEventListener("submit",(e)=>{
        const email=document.getElementById("email").value.trim()
        const password=document.getElementById("password").value.trim()
        e.preventDefault();
        if(!email|| !password){
             Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "no field should be empty",
                
            });
            return
        }
        e.target.submit()
    })
</script>

